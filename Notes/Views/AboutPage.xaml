<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:Notes.ViewModels"
             BackgroundColor="#3E8EED"
             x:Class="Notes.Views.AboutPage">
    <ContentPage.BindingContext>
        <viewModels:AboutViewModel />
    </ContentPage.BindingContext>
    <VerticalStackLayout Spacing="10" Margin="10">
        <HorizontalStackLayout Spacing="10">
            <Image Source="icon_about.png"
                   SemanticProperties.Description="The dot net bot waving hello!"
                   HeightRequest="64" />
            <Label FontSize="22" FontAttributes="Bold" Text="{Binding Title}" VerticalOptions="End" TextColor="White" />
            <Label FontSize="22" Text="{Binding Version}" TextColor="White" VerticalOptions="End"  />
        </HorizontalStackLayout>

        <Label Text="{Binding Message}" FontSize="20" TextColor="White"/>
        <!--<Button Text="Learn more..." Command="{Binding ShowMoreInfoCommand}" />-->
    </VerticalStackLayout>

</ContentPage>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:Notes.ViewModels"
             xmlns:Converters="clr-namespace:Notes.Models.Converters"
             x:Class="Notes.Views.ArchivedPage"
             Title="Archiwum Notatek"
             xmlns:fonts="clr-namespace:Notes.Models.Helpers"
             BackgroundColor="#3E8EED"
             NavigatedTo="ContentPage_NavigatedTo">
    
    <ContentPage.BindingContext>
        <viewModels:ArchivedPageViewModel />
    </ContentPage.BindingContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackLayout>
            <StackLayout Orientation="Horizontal" VerticalOptions="Center" Spacing="15" Margin="10,0,0,0">
                <Label Text="Liczba Notatek: " TextColor="White" FontSize="20"/>
                <Label Text="{Binding AllNotes.Count}" TextColor="White" FontSize="20"/>
            </StackLayout>

            <StackLayout Orientation="Horizontal" VerticalOptions="Center" Spacing="15" Margin="10,0,0,0">
                <Label Text="Widok Poziomy: " TextColor="White" VerticalOptions="Center" VerticalTextAlignment="Center" FontSize="20"/>
                <Switch IsToggled="{Binding IsHorizontalThemeEnabled, Mode=TwoWay}" OnColor="White"/>
            </StackLayout>
        </StackLayout>

        <!-- Display notes in a list -->
        <CollectionView x:Name="notesCollection"
                Grid.Row="1"
                ItemsSource="{Binding AllNotes}"
                Margin="20"
                SelectionMode="Single"
                SelectionChangedCommand="{Binding NoteSelectedCommand}"
                SelectionChangedCommandParameter="{Binding Source={RelativeSource Self}, Path=SelectedItem}">
            <CollectionView.IsVisible>
                <Binding Path="IsHorizontalThemeEnabled">
                    <Binding.Converter>
                        <Converters:BooleanInverseConverter/>
                    </Binding.Converter>
                </Binding>
            </CollectionView.IsVisible>
            
            <!-- Designate how the collection of items are laid out -->
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
            </CollectionView.ItemsLayout>

            <!-- Define the appearance of each item in the list -->
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <StackLayout BackgroundColor="White">
                        <Label FontSize="22">
                            <Label.Text>
                                <Binding Path="Text">
                                    <Binding.Converter>
                                        <Converters:NoteTitleConverter>
                                        </Converters:NoteTitleConverter>
                                    </Binding.Converter>
                                </Binding>
                            </Label.Text>
                        </Label>
                        <Label Text="{Binding CreatingDate}" FontSize="14" TextColor="Silver"/>
                    </StackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <StackLayout IsVisible="{Binding IsHorizontalThemeEnabled}"
            Grid.Row="1">
            <FlexLayout 
                 
                BindableLayout.ItemsSource="{Binding AllNotes}"
                Wrap="Wrap"
                AlignItems="Start">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer 
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage} }, Path=BindingContext.NoteSelectedCommand}"
                                    CommandParameter="{Binding}"/>
                            </Grid.GestureRecognizers>
                            <Frame>
                                <StackLayout>
                                    <Label FontSize="22" Margin="10,0,0,0">
                                        <Label.Text>
                                            <Binding Path="Text">
                                                <Binding.Converter>
                                                    <Converters:NoteTitleConverter>
                                                    </Converters:NoteTitleConverter>
                                                </Binding.Converter>
                                            </Binding>
                                        </Label.Text>
                                    </Label>
                                    <Label Text="{Binding CreatingDate}" Margin="10,0,0,0"  FontSize="14" TextColor="Silver"/>
                                </StackLayout>
                            </Frame>
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>
        </StackLayout>
    </Grid>
</ContentPage>